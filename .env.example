# Copy of the settings the app needs, with no real values.
# On your computer, run `npm run setup-login` to create a real .env file.
# On the host, these go in its environment settings.

OWNER_EMAIL=you@example.com
# Scrambled password made by `npm run setup-login`. Never the password itself.
OWNER_PASSWORD_HASH=
# Long random text used to sign login sessions.
SESSION_SECRET=
PORT=3000
# Set on the host only. Left empty on your computer, where a built-in database is used.
DATABASE_URL=

# Twilio texting. Leave all four empty and no text can be sent.
# Fill in all four, or the app refuses to start and says which one is missing.
# Found in the Twilio console. Starts with AC.
TWILIO_ACCOUNT_SID=
# Found next to the Account SID. Keep it secret.
TWILIO_AUTH_TOKEN=
# Your approved sending number (like +14805550100) or Messaging Service ID (starts with MG).
TWILIO_FROM=
# The app's public https address. Twilio sends STOP replies and delivery updates here.
PUBLIC_URL=
