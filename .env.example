# Copy of the settings the app needs, with no real values.
# On your computer, run `npm run setup-login` to create a real .env file.
# On the host, these go in its environment settings.

OWNER_EMAIL=you@example.com
# Scrambled password made by `npm run setup-login`. Never the password itself.
OWNER_PASSWORD_HASH=
# Long random text used to sign login sessions.
SESSION_SECRET=
PORT=3000
# Set on the host only. Left empty on your computer, where a built-in database is used.
DATABASE_URL=
